# Read-only demo. There is nothing secret in here: no accounts, no mail, no
# queues, no external services. The database is a throwaway SQLite file that is
# rebuilt from the seeder every time the container starts.

APP_NAME="Materials ERP"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://erp-demo.wzco.net

APP_LOCALE=bg
APP_FALLBACK_LOCALE=bg
APP_TIMEZONE=Europe/Sofia

# Everything a request could write to is switched off. Nothing touches disk, so
# the container can run with a read-only root filesystem.
LOG_CHANNEL=stderr
LOG_LEVEL=warning
SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync
MAIL_MAILER=log

DB_CONNECTION=sqlite
DB_DATABASE=/srv/demo/demo.sqlite
DB_FOREIGN_KEYS=true

# Unset means "read-only unless we are the seeder", which is what you want.
# See config/demo.php.
# DEMO_READ_ONLY_DATABASE=true

# Unset means the seeded movements are laid out backwards from today, so the
# demo always looks current. Set a date to reproduce a dataset exactly.
# DEMO_SEED_DATE=2026-08-01
